# Local development without Docker: copy to .env and run `npm run dev`.
# Leave SMTP_HOST empty to save e-mails as files in data/outbox,
# or run Mailpit (docker run -p 8025:8025 -p 1025:1025 axllent/mailpit) and point at it.
APP_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_NAME=הזמנת רכב (פיתוח)
MAIL_FROM=car-rental@localhost
# SMTP_HOST=localhost
# SMTP_PORT=1025
