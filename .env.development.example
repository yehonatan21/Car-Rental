# Local development without Docker: copy to .env and run `npm run dev`.
# Leave SMTP_HOST empty to save e-mails as files in data/outbox,
# or run Mailpit (docker run -p 8025:8025 -p 1025:1025 axllent/mailpit) and point at it.
APP_ENV=development
PORT=3000
BASE_URL=https://localhost:3000
# The dev server speaks HTTPS with an auto-generated self-signed certificate (data/certs/).
# The browser warns once about it; to avoid that, create a trusted one with mkcert
# (mkcert -install && mkcert localhost 127.0.0.1) and point to it:
# HTTPS_CERT_FILE=./localhost+1.pem
# HTTPS_KEY_FILE=./localhost+1-key.pem
APP_NAME=הזמנת רכב (פיתוח)
MAIL_FROM=car-rental@localhost
# SMTP_HOST=localhost
# SMTP_PORT=1025
