PORT=3000
BASE_URL=https://car.example.org
NODE_ENV=production
# Public domain for Caddy (docker-compose.prod.yml), which gets the Let's Encrypt certificate.
DOMAIN=car.example.org
# HTTPS is terminated by Caddy; set HTTPS=true + HTTPS_CERT_FILE/HTTPS_KEY_FILE to serve TLS from Node instead.
# HTTPS=false
APP_NAME=הזמנת רכב
MAIL_FROM=car@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sign in with Google: redirect URI https://<DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
