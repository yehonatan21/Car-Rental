{
  "name": "car-rental",
  "version": "1.0.0",
  "description": "מערכת להזמנת רכב משותף",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --no-warnings --env-file-if-exists=.env scripts/seed.js",
    "tunnel": "node --no-warnings --env-file-if-exists=.env scripts/tunnel.js",
    "create-admin": "node --no-warnings --env-file-if-exists=.env scripts/create-admin.js",
    "lint": "eslint .",
    "test": "node --no-warnings --test --test-concurrency=4 \"test/**/*.test.js\"",
    "test:unit": "node --no-warnings --test \"test/unit/*.test.js\"",
    "test:e2e": "node --no-warnings --test \"test/e2e/*.test.js\"",
    "test:coverage": "node --no-warnings --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"test/**/*.test.js\"",
    "test:libsql": "node --no-warnings --test --test-concurrency=4 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "libsql": "^0.5.29",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
