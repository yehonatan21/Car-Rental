{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,public,node_modules/@libsql}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
