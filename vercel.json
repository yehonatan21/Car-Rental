{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,public}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/api/index"
    }
  ]
}
