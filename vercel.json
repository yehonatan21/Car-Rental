{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "node scripts/vercel-ignore-build.js",
  "git": {
    "deploymentEnabled": {
      "dev": false,
      "dependabot/**": false,
      "claude/**": false,
      "fix/**": false,
      "feature/**": false
    }
  },
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,public,node_modules/@libsql/linux-*-gnu}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
